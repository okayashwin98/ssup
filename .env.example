# Copy to .env.local (git ignores it) and fill in. See docs/SHARING_SETUP.md.

# Your share service's upload address and password (the Worker's API_SECRET).
# Both are built into the app: never share your build.
VITE_CLOUD_SHARE_ENDPOINT=
VITE_CLOUD_SHARE_SECRET=

# Your name, until you set one in the app's Settings.
VITE_PROFILE_NAME=

# Recordly's sign-in service. Leave empty for SuperShare: when set, the app stops
# sending the share password. Never put a Supabase service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
